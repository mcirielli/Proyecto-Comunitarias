# Ejemplos públicos. No son credenciales válidas. Spring usa variables del proceso.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Completar solo para el perfil supabase; copiar los datos del panel Connect.
SUPABASE_JDBC_URL=jdbc:postgresql://HOST_DEL_SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USER=USUARIO_DEL_PANEL_CONNECT
SUPABASE_DB_PASSWORD=REEMPLAZAR_LOCALMENTE
# Vite carga la .env de frontend/. Nunca incluir secretos en VITE_*.
VITE_API_BASE_URL=http://localhost:8080
